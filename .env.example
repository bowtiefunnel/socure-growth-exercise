# copy to .env — never commit .env
BITSCALE_API_KEY=            # enrichment waterfall (workspace key; X-API-KEY header)
BITSCALE_GRID_ID=            # UI-built enrichment grid w/ "BitScale API" source; cascade skips Bitscale if unset
NREV_WEBHOOK_URL=            # nRev Play webhook (enrichment-service Play, see docs/nrev-play-spec.md); skipped if unset
ANTHROPIC_API_KEY=           # battle cards + brief narration (cheap model)
LANGFUSE_PUBLIC_KEY=         # LLM observability (optional — pipeline runs without it)
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
